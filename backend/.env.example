# Copy to backend/.env and adjust. Every setting in app/core/config.py can be set here.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./smartcart.db
# PostgreSQL example (pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/smartcart

# Load the demo catalog, stores and accounts on first start.
AUTO_SEED=true

# Required in production. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production

# Shows the login OTP on screen. Turn off once an SMS provider is wired into app/services/notifications.py.
OTP_DEV_MODE=true

# Origins allowed to call the API from a browser (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Bill rules (₹)
FREE_DELIVERY_THRESHOLD=199
DELIVERY_FEE=25
SMALL_CART_THRESHOLD=99
SMALL_CART_FEE=20
HANDLING_FEE=2

# Moves orders through their statuses automatically so tracking can be demoed.
SIMULATE_ORDER_PROGRESS=true
PICKUP_LEAD_MINUTES=30
