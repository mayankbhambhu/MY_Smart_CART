# Copy to backend/.env and adjust. Every setting in app/core/config.py can be set here or as an
# environment variable (on Render: the service's Environment tab).

# development | test: your machine. demo: hosted for trying out (codes on screen and test payments
# allowed). production: real customers (needs real SMS and a real secret; no simulated payments).
ENVIRONMENT=development
DATABASE_URL=sqlite:///./smartcart.db
# PostgreSQL, e.g. the URL Render gives you (postgres:// and postgresql:// both work):
# DATABASE_URL=postgresql://user:password@localhost:5432/smartcart
# MySQL / MariaDB, e.g. on your Mac (create it with CHARACTER SET utf8mb4 first):
# DATABASE_URL=mysql://root:password@localhost:3306/smartcart

# Load the demo catalog, stores and accounts into an empty database.
AUTO_SEED=true

# Required anywhere but your own machine. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me-in-production

# ---- Login codes (SMS) ----------------------------------------------------------------------
# console:        no SMS, the code is shown on the login screen (development and demo only).
# messagecentral: Message Central VerifyNow; sends from its own approved template (no DLT of your own).
# msg91:          MSG91 OTP API. Create an OTP template containing ##OTP## that is approved on DLT.
# twilio:         Twilio Messaging (Indian numbers still need your DLT sender ID and template).
SMS_PROVIDER=console
# MESSAGECENTRAL_CUSTOMER_ID=C-XXXXXXXXXXXXXXX
# MESSAGECENTRAL_PASSWORD=
# MESSAGECENTRAL_EMAIL=               # only if your Message Central account asks for it
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX            # or a Messaging Service SID (MG...)
# Lets Chrome on Android fill the code in automatically (your site's domain, no https://):
# WEBOTP_DOMAIN=smart-cart.onrender.com
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=30
OTP_MAX_PER_HOUR=300                  # all numbers together: caps the SMS bill if someone abuses it

# Mobile numbers that get the admin role on startup (comma-separated). Use with real SMS.
# ADMIN_PHONES=98XXXXXXXX

# ---- Your business (policy pages at /terms /privacy /refund-policy /shipping-policy /pricing /contact)
# Required with ENVIRONMENT=production (GSTIN is optional).
# BUSINESS_LEGAL_NAME=Sharma Retail Pvt Ltd
# BUSINESS_ADDRESS=SCO 42, Sector 29, Gurugram, Haryana 122001
# SUPPORT_EMAIL=help@yourshop.in
# SUPPORT_PHONE=+91 98XXX XXXXX
# GRIEVANCE_OFFICER=Your Name
# GSTIN=

# ---- Payments (Razorpay) ----------------------------------------------------------------------
# Dashboard → Account & Settings → API Keys. Test keys start with rzp_test_, live keys with rzp_live_.
# Without keys, "Pay online" opens a built-in test checkout (never in production).
# RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your-app>/api/payments/razorpay/webhook,
# events payment.captured, order.paid and payment.failed, and the same secret as here.
# RAZORPAY_WEBHOOK_SECRET=
SIMULATED_PAYMENTS=true
PAYMENT_TIMEOUT_MINUTES=15            # unpaid online orders are cancelled and their stock released

# Origins allowed to call the API from a browser (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Bill rules (₹)
FREE_DELIVERY_THRESHOLD=199
DELIVERY_FEE=25
SMALL_CART_THRESHOLD=99
SMALL_CART_FEE=20
HANDLING_FEE=2

# Moves orders through their statuses automatically so tracking can be demoed.
SIMULATE_ORDER_PROGRESS=true
PICKUP_LEAD_MINUTES=30
